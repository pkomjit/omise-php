{
    "name": "pkomjit/omise-php",
    "description": "PHP SDK for Omise Payment Gateway - Support PromptPay, Credit Card, and various payment methods",
    "keywords": [
        "omise",
        "payment",
        "gateway",
        "promptpay",
        "thailand",
        "qr-payment",
        "opn"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your@email.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Omise\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omise\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html coverage",
        "phpstan": "vendor/bin/phpstan analyse src --level=8",
        "cs-fix": "vendor/bin/php-cs-fixer fix src"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omise\\Laravel\\OmiseServiceProvider"
            ],
            "aliases": {
                "Omise": "Omise\\Laravel\\Facades\\Omise"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}
